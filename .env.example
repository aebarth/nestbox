# Nestbox configuration — copy to .env and edit.

# REQUIRED: long random string; encrypts stored cloud credentials and signs sessions.
# Generate one with:  openssl rand -hex 32
SECRET_KEY=change-me

# Postgres (internal to Docker; change password for good hygiene)
POSTGRES_USER=nestbox
POSTGRES_PASSWORD=nestbox-change-me
POSTGRES_DB=nestbox

# Host folder that contains the document folders you want to track.
# Mount network shares on the HOST first (macOS: Finder > Go > Connect to Server;
# Windows: map a drive; Linux: cifs mount), then point this at a folder that
# contains them (or at the share itself).
NESTBOX_SOURCES_PATH=./sample-data/sources

# Host folder where your scanner drops new PDFs (the "inbox").
NESTBOX_INBOX_PATH=./sample-data/inbox

# Where the web app is reachable (used in QR codes on printed labels)
APP_BASE_URL=http://localhost:3000

# Ports on the host
FRONTEND_PORT=3000
BACKEND_PORT=8000
